nr_passes = 3

[source]
image_dir = ""
output_dir = "D:\\Output"
frames_to_use = "all"
extra_vel_dim_m = 0.01

[camera]
camera_dir = ""
calib_dir = "C:\\Users\\local2\\Documents\\GitHub\\tcm-piv\\examples\\image_pair\\output\\calibration\\calibration_image_260108_141319_metadata.json"
calib_spacing_mm = 1.0

[preprocessing]
background_dir = ""
crop_roi = [0, 0, 73, -73]
ds_factor = [4, 1, 1]

[correlation]
n_corrs_to_sum = [5, 5, 5]
n_windows = [[1, 1], [1, 8], [1, 24]]
window_overlap = 0.6

[displacement]
n_peaks = 10
min_peak_dist_px = 1

[postprocessing]
outlier_filter_mode = "semicircle_rect"
max_velocity_vy_vx = [50, 10]
flow_direction = "y"
extra_vel_dim_m = 0.01
nb_size_tyx = [[9, 1, 1], [7, 1, 3], [9, 1, 3]]
nb_threshold = 5
time_smooth_lam = 0
interp_nb_size_tyx = [1, 1, 7]

[visualisation]
plot_model = false
model_gender = "male"
model_mass = 70.0
model_height = 1.93
plot_global_filters = true
plot_correlations = false
plot_window_layout = true
plot_flow_rate = true
export_velocity_profiles_pdf = true
